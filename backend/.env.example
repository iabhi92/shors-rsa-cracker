# Copy to backend/.env (git-ignored) if you need to override these. Both have safe defaults
# for local development and this file has no real secrets in it -- the backend never reads
# IBM_QUANTUM_API_KEY/IBM_QUANTUM_CRN (see quantum/ibm_hardware.py and
# backend/app/routers/ibm.py's module docstrings) or any other credential.

# Comma-separated list of origins allowed to call this API (CORS). Defaults to the Vite dev
# server's own origin; set this to your deployed frontend's URL in production.
CORS_ALLOW_ORIGINS=http://localhost:5173
